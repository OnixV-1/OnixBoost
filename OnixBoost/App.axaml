<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OnixBoost.App"
             Name="OnixBoost"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/onixboost-tray.png"
                ToolTipText="OnixBoost"
                Clicked="OnTrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Открыть" Click="OnTrayShow"/>
            <NativeMenuItem Header="STOP" Click="OnTrayStop"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Выход" Click="OnTrayExit"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
